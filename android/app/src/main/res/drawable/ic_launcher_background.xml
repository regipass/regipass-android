<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptif uygulama simgesinin zemini: BrandColors.gradient'in
     (linear-gradient(135deg, red, redDark)) Android karşılığı.
     angle="315" sol-üstten sağ-alta akar; CSS'teki 135deg ile aynı yön. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/ic_launcher_gradient_end"
        android:startColor="@color/ic_launcher_gradient_start"
        android:type="linear" />
</shape>
