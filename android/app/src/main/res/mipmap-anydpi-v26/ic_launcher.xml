<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ uygulama simgesi. Başlatıcı kendi maskesini (daire, squircle,
     kare...) uyguladığı için katmanlar tam tuvale çiziliyor; mipmap-*'taki
     PNG yalnızca daha eski sürümlerde kullanılıyor.

     <monochrome> Android 13+ temalı simge içindir: sistem ön planın alfasını
     alıp duvar kâğıdından türettiği rengi basar. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
