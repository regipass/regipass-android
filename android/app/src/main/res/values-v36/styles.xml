<?xml version="1.0" encoding="utf-8"?>
<!-- Android 16 (API 36) ve sonrası: edge-to-edge muafiyeti YOK.

     values/styles.xml'deki `android:windowOptOutEdgeToEdgeEnforcement`
     bu sürümlerde çökmeye yol açabiliyor; buradaki kopya aynı temaları
     muafiyet satırı olmadan verir. Sonuç: bu cihazlarda alt gezinme çubuğu
     gizlenmez, uygulama iki çubukla (bugünkü gibi) çalışır
     (bkz. lib/app/system_ui.dart -> autoHideNavigationBarSupported). -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Kontrast dolgusunun gerekçesi: values/styles.xml. -->
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Kontrast dolgusunun gerekçesi: values/styles.xml. -->
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
</resources>
