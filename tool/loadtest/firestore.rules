rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Yonetici (admin) hesabinin UID'si.
    // ADIM: Firebase Console > Authentication bolumunde a@regipass.app
    // hesabini olusturduktan sonra UID'sini kopyalayip asagiya yapistir.
    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "AY1gi7Zi9AcqhjZinEkR1baB9T72";
    }

    // ── Kulup yetkisi ─────────────────────────────────────────────────────
    // ONEMLI: Yetki "users" belgesinden OKUNMAZ. O belgeyi kullanicinin
    // kendisi yazabildigi icin (asagidaki users kurali) role/lastRole alanlari
    // istemcinin BEYANIDIR, kanit degil. Eskiden isClubUser() bu beyana
    // bakiyordu: herhangi bir ogrenci kendi users belgesine role: "club"
    // yazip etkinlik olusturabiliyordu. Yetki artik yalnizca kulup profilinin
    // kendisinden gelir; o belgede onay durumunu ise sadece admin degistirebilir
    // (bkz. club_profiles kurallari).
    function clubProfileRef() {
      return get(/databases/$(database)/documents/club_profiles/$(request.auth.uid));
    }

    // Bilgi formunu tamamlamis, engellenmemis kulup.
    //
    // Alanlar get(...) ile VARSAYILANLI okunur: eski belgelerde clubStatus ya
    // da onboardingCompleted hic olmayabilir ve dogrudan erisim kuralin
    // degerlendirme hatasiyla patlamasina, yani mesru bir kulubun de
    // reddedilmesine yol acardi.
    function isClubUser() {
      return isSignedIn()
        && clubProfileRef() != null
        && clubProfileRef().data.get("onboardingCompleted", false) == true
        && clubProfileRef().data.get("clubStatus", "") != "banned";
    }

    // Belgeleri admin tarafindan onaylanmis kulup. Etkinlik olusturmak icin
    // sart: onay kapisini atlayan bir hesap etkinlik yayinlayamaz.
    function isApprovedClub() {
      return isClubUser()
        && clubProfileRef().data.get("clubStatus", "") == "approved";
    }

    function eventDoc(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId));
    }

    // ── Ucretli etkinlik onay logu ────────────────────────────────────────
    // Ucretli etkinliklerde iki taraf da bir metni onaylar ve onay logu
    // ETKINLIK verisine yazilir (bkz. mobil docs/ucretli-etkinlik-onay-logu.md):
    //   • kulup  -> events/{eventId}.paidConsentLog
    //   • ogrenci-> event_registrations/{id}.paidConsentLog
    // Sema iki istemcide de ayni (web: club-create-event.js / dashboard.js,
    // mobil: lib/domain/paid_event_consent.dart).
    //
    // Bu kurallar onayi ZORUNLU tutar: onaysiz ucretli etkinlik olusturulamaz
    // ve onaysiz ucretli kayit yazilamaz. Istemcideki pop-up atlatilsa bile
    // sinir burasidir.
    // Alanlar get(...) ile VARSAYILANLI okunur: log hic yoksa ya da yanlis
    // tipteyse kural degerlendirme HATASI vermez, dogal olarak false doner.
    function paidConsentLog(data) {
      return data.get("paidConsentLog", {});
    }

    function paidConsentLogValid(data) {
      return paidConsentLog(data) is map
        && paidConsentLog(data).get("approved", false) == true
        && paidConsentLog(data).get("text", "") is string
        && paidConsentLog(data).get("text", "").size() > 0
        && paidConsentLog(data).get("approvedAtMs", 0) is int
        && paidConsentLog(data).get("approvedAtMs", 0) > 0;
    }

    function isPaidEventData(data) {
      return data.get("feeType", "") == "paid";
    }

    // Uretimde kayit kosullarini asla atlama. Gecici tanilama icin bu deger
    // yalnizca yerel bir test dalinda acilabilir; yayinlanan kuralda kapali
    // kalmalidir.
    function registrationDebugMode() {
      return false;
    }

    // "users" belgesi kullanicinin kendi ozet kaydidir (panel gosterimi ve
    // yonetici listeleri). YETKI KAYNAGI DEGILDIR — role/lastRole/roles
    // alanlari istemci beyanidir ve hicbir kural bunlara bakmaz.
    //
    // Buna karsilik onay/engel alanlari burada da kilitlidir: kullanici kendi
    // kaydina "clubStatus: approved" ya da "banned: false" yazip yonetici
    // ekranlarini yaniltamasin, kendi engelini kaldiramasin.
    //
    // DIKKAT: merge/update yazmalarinda request.resource.data BIRLESMIS
    // belgedir; istemci alana hic dokunmasa bile belgede varsa burada gorunur.
    // Bu yuzden "alan istekte var mi" degil "degeri degisti mi" sorulur.
    match /users/{userId} {
      function clubStatusUnchanged() {
        return !("clubStatus" in request.resource.data)
          || (
            resource != null
            && "clubStatus" in resource.data
            && request.resource.data.clubStatus == resource.data.clubStatus
          );
      }

      // Kulup kendini yalnizca inceleme ONCESI durumlara alabilir; "approved"
      // ve "banned" kararlari admin'e aittir.
      function clubStatusSelfWritable() {
        return request.resource.data.clubStatus in ["documents_pending", "pending_review"];
      }

      // Yetkili kaynak club_profiles; oradaki deger buraya kopyalanabilir.
      // (Kulup bilgilerini duzenleyen ONAYLI bir kulubun yazmasi bu daldan gecer.)
      function clubStatusMatchesProfile() {
        return clubProfileRef() != null
          && request.resource.data.clubStatus == clubProfileRef().data.get("clubStatus", "");
      }

      function banFlagUnchanged() {
        return !("banned" in request.resource.data)
          || (
            resource != null
            && "banned" in resource.data
            && request.resource.data.banned == resource.data.banned
          );
      }

      allow read: if isOwner(userId) || isAdmin();

      // "write" DEGIL "create, update": silme ayri ele alinmali. Silme
      // isteginde request.resource null'dur, bu yuzden yukaridaki
      // clubStatusUnchanged/banFlagUnchanged kontrolleri (hepsi
      // request.resource.data okur) hata verir ve silme HER ZAMAN reddedilirdi.
      allow create, update: if isAdmin()
        || (
          isOwner(userId)
          && (
            clubStatusUnchanged()
            || clubStatusSelfWritable()
            || clubStatusMatchesProfile()
          )
          && banFlagUnchanged()
        );

      // Hesap silme: kullanici kendi users belgesini kaldirabilir (bkz.
      // js/modules/auth/account-delete-modal.js ve account-expiry.js'teki
      // suresi dolan kayit temizligi).
      //
      // Engellenmis hesap SILEMEZ: silip ayni e-postayla yeniden kaydolarak
      // engeli asmasin (student_profiles / club_profiles ile ayni desen).
      allow delete: if isAdmin()
        || (
          isOwner(userId)
          && resource.data.get("banned", false) != true
          && resource.data.get("clubStatus", "") != "banned"
        );
    }

    // Telefon dogrulamasi: phoneVerified yalnizca gercek Firebase Auth telefon
    // baglamasi sonrasinda (ID token'daki phone_number iddiasi, profildeki phone
    // alaniyla eslesirse) true yazilabilir. Boylece istemci tarafindan sahte
    // "phoneVerified: true" yazilmasi engellenir (token sunucu tarafinda dogrulanir).
    // DIKKAT: request.resource.data, GUNCELLEMEDE yazilan alanlari degil BIRLESMIS
    // (merge sonrasi) belgeyi temsil eder. Yani istemci phoneVerified'a hic
    // dokunmasa bile, belgede zaten varsa alan burada GORUNUR. Bu yuzden
    // "alan istekte var mi" kontrolu tek basina yetmez.
    //
    // Bu fonksiyon: telefon numarasi VE dogrulama bayragi ikisi de aynen
    // korunuyorsa (kullanici sadece isim/bolum/fotograf gibi baska alanlari
    // guncelliyorsa) yazmanin telefon dogrulamasiyla hicbir ilgisi yoktur.
    // Bu dal olmadan, telefonu dogrulanmis HER ogrencinin her profil
    // guncellemesi taze bir phone_number iddiasi gerektirir ve reddedilir.
    function phoneFieldsUnchanged() {
      return resource != null
        && ("phoneVerified" in resource.data)
        && ("phone" in resource.data)
        && ("phone" in request.resource.data)
        && resource.data.phoneVerified == request.resource.data.phoneVerified
        && resource.data.phone == request.resource.data.phone;
    }

    function phoneVerificationValid() {
      // Alan hic dokunulmadiysa (baska bir kayit akisi phoneVerified'i degistirmiyorsa) serbest.
      // Telefon ve dogrulama bayragi aynen korunuyorsa da serbest (bkz. phoneFieldsUnchanged).
      // Degisiyorsa MUTLAKA boolean olmali (string/number gibi sahte "true" degerleri reddedilir).
      // false yazmak her zaman serbesttir; true yazmak icin ID token'daki phone_number
      // iddiasi (yalnizca gercek Firebase Auth telefon baglamasindan sonra olusur)
      // profildeki phone alaniyla birebir eslesmelidir.
      return !("phoneVerified" in request.resource.data)
        || phoneFieldsUnchanged()
        || (
          request.resource.data.phoneVerified is bool
          && (
            request.resource.data.phoneVerified == false
            || (
              request.auth.token.phone_number is string
              && request.resource.data.phone is string
              && request.auth.token.phone_number == request.resource.data.phone
            )
          )
        );
    }

    // ── Dogrulanmamis kaydin omru ("expireAt") ────────────────────────────
    // "expireAt", Firestore TTL politikasinin okudugu tarihtir: tarih gecince
    // belge KENDILIGINDEN silinir (bkz. firestore.indexes.json > fieldOverrides
    // ve js/modules/auth/account-expiry.js). Telefonunu 3 gun icinde
    // dogrulamayan ogrenci kaydi boylece veritabaninda kalmaz.
    //
    // Tarih istemcide hesaplanir (TTL gercek bir zaman damgasi ister,
    // serverTimestamp'a gun eklenemez), bu yuzden burada TAVAN uygulanir; aksi
    // halde bir istemci cok ileri bir tarih yazip silinmekten kurtulabilirdi.
    //
    // Tavan neden 3 degil 7 gun: kullanicinin sistem saati bozuksa dogru niyetli
    // bir KAYIT ISLEMI reddedilmemeli. 7 gun, saati birkac gun ileri olan gercek
    // kullaniciyi kirmadan kotuye kullanimi kisa tutar.
    function expiryDeadlineValid() {
      return !("expireAt" in request.resource.data)
        || (
          request.resource.data.expireAt is timestamp
          && request.resource.data.expireAt < request.time + duration.value(7, 'd')
        );
    }

    // Sure yalnizca telefon DOGRULANDIGINDA kaldirilabilir; dogrulanmamis bir
    // kayit kendi silinme tarihini silemez. (phoneVerified == true yazmak zaten
    // gercek bir phone_number iddiasi gerektirir, bkz. phoneVerificationValid.)
    function expiryNotDropped() {
      return !(resource != null && "expireAt" in resource.data)
        || ("expireAt" in request.resource.data)
        || (
          "phoneVerified" in request.resource.data
          && request.resource.data.phoneVerified == true
        );
    }

    // Ogrenci profilleri: sahibi tam erisim (telefon dogrulama korumasiyla);
    // admin istatistik/ban ekranlari icin okuma+yazma (kulup profilleriyle ayni desen).
    match /student_profiles/{userId} {
      // Engelleme kararini yalnizca admin verir; ogrenci kendi kaydindaki
      // "banned" bayragini temizleyip engelini kaldiramaz.
      // (merge yazmalarinda alan istekte GORUNUR, bu yuzden degeri karsilastirilir.)
      function banFlagUnchanged() {
        return !("banned" in request.resource.data)
          || (
            resource != null
            && "banned" in resource.data
            && request.resource.data.banned == resource.data.banned
          );
      }

      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isAdmin()
        || (
          isOwner(userId)
          && phoneVerificationValid()
          && expiryDeadlineValid()
          && expiryNotDropped()
          && banFlagUnchanged()
        );
      // Engellenmis ogrenci profilini SILEMEZ: aksi halde kaydini silip
      // ayni hesapla yeniden kaydolarak engeli asardi.
      allow delete: if isAdmin()
        || (isOwner(userId) && resource.data.get("banned", false) != true);
    }

    // Kulup profilleri: sahibi tam erisim (telefon dogrulama korumasiyla); admin onay/engelleme icin okuma+yazma.
    match /club_profiles/{userId} {
      // ── Onay kapisi ─────────────────────────────────────────────────────
      // Bu belge kulup yetkisinin TEK kaynagidir (bkz. isClubUser /
      // isApprovedClub). Dolayisiyla onay ve engel alanlari sahibine kapali:
      // aksi halde kulup kendi belgesine "clubStatus: approved" yazip belge
      // incelemesini atlar ve etkinlik yayinlardi.
      //
      // Sahibin yazabildigi durumlar yalnizca inceleme ONCESI olanlar:
      //   documents_pending -> belge yukleme asamasi (ilk kayit / admin iade)
      //   pending_review    -> belgeler yuklendi, kuyruga alindi
      // "approved" ve "banned" yalnizca admin tarafindan yazilabilir.
      function clubStatusUnchanged() {
        return !("clubStatus" in request.resource.data)
          || (
            resource != null
            && "clubStatus" in resource.data
            && request.resource.data.clubStatus == resource.data.clubStatus
          );
      }

      function clubStatusSelfWritable() {
        return request.resource.data.clubStatus in ["documents_pending", "pending_review"];
      }

      function banFlagUnchanged() {
        return !("banned" in request.resource.data)
          || (
            resource != null
            && "banned" in resource.data
            && request.resource.data.banned == resource.data.banned
          );
      }

      // Yoneticinin kulube yazdigi mesajlar (bkz. js/modules/admin/club-messages.js)
      // bu belgede durur ama SAHIBINE kapalidir: kulup kendisine gonderilen
      // "eksik belge" notunu silemez ya da kendi kendine mesaj uyduramaz.
      // Alan zaten varsa istekte AYNEN gelmelidir; boylece merge olmayan bir
      // yazma da diziyi silemez.
      function adminMessagesUnchanged() {
        return (resource != null && "adminMessages" in resource.data)
          ? (
            "adminMessages" in request.resource.data
            && request.resource.data.adminMessages == resource.data.adminMessages
          )
          : !("adminMessages" in request.resource.data);
      }

      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isAdmin()
        || (
          isOwner(userId)
          && phoneVerificationValid()
          && (clubStatusUnchanged() || clubStatusSelfWritable())
          && banFlagUnchanged()
          && adminMessagesUnchanged()
        );
      // Engellenmis kulup profilini SILEMEZ: silip yeniden kaydolarak
      // engeli asmasin.
      allow delete: if isAdmin()
        || (
          isOwner(userId)
          && resource.data.get("clubStatus", "") != "banned"
          && resource.data.get("banned", false) != true
        );
    }

    // ── Telefon ipuclari (sifre sifirlama ekrani icin) ────────────────────
    // Anahtar: e-postanin SHA-256'si. Icerik: maskelenmis metin
    // ("+90 XXX XXX XX 67") VE tam numaranin SHA-256 hash'i (phoneHash, geri
    // cevrilemez). Tam numaranin DUZ METNI, e-posta veya baska profil alani
    // BURADA TUTULMAZ (bkz. js/modules/auth/phone-hint.js).
    //
    // get  : acik — sifresini unutmus kullanici giris YAPMAMIS durumdadir,
    //        kendi ipucunu okuyabilmesi icin baska yol yok.
    // list : KAPALI — koleksiyon listelenip toplu numara taramasi yapilamaz;
    //        yalnizca tam anahtari (e-posta hash'ini) bilen tek tek okuyabilir.
    //
    // Kurallar hash hesaplayamadigi icin "anahtar gercekten bu kullanicinin
    // e-postasina mi ait" dogrulanamaz; yani giris yapmis bir kullanici baska
    // bir anahtarin ipucunun uzerine yazabilir. Bu YALNIZCA GORSEL bir etkidir:
    // dogrulama SMS'i her zaman Firebase Auth'a bagli gercek numaraya gider,
    // bu yuzden guvenlik sinirini degistirmez. Kotuye kullanimi sinirlamak icin
    // yazilabilecek alanlar ve uzunluk asagida kisitlanmistir.
    match /phone_hints/{emailHash} {
      allow get: if true;
      allow list: if false;

      // Mobil: maske + roller. Eski web: maske + phoneHash.
      // phoneHash eski istemciler icin opsiyonel; mobil hash yayimlamaz.
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(["maskedPhone", "roles", "phoneHash", "updatedAt"])
        && request.resource.data.maskedPhone is string
        && request.resource.data.maskedPhone.size() > 0
        && request.resource.data.maskedPhone.size() <= 40
        && (!('phoneHash' in request.resource.data)
          || (request.resource.data.phoneHash is string
            && request.resource.data.phoneHash.size() == 64))
        && (!('roles' in request.resource.data)
          || (request.resource.data.roles is list
            && request.resource.data.roles.size() > 0
            && request.resource.data.roles.size() <= 2
            && request.resource.data.roles.hasOnly(['student', 'club'])));

      allow delete: if false;
    }

    // ── Telefon sahiplik kaydi (numara teklik kontrolu) ───────────────────
    // Anahtar: E.164 numara ("+905551234567"). Icerik: SADECE sahibin uid'si.
    // Amaci, kullanici numarayi YAZARKEN "bu numara baskasina ait" uyarisini
    // verebilmek (bkz. js/modules/auth/phone-registry.js).
    //
    // get  : giris yapmis kullaniciya acik — profil koleksiyonlari bilerek
    //        yalnizca sahibine acik oldugu icin teklik baska turlu sorulamaz.
    // list : KAPALI — koleksiyon listelenip toplu numara/uid taramasi yapilamaz.
    //
    // YAZMA SINIRI: kayit ancak ID token'indaki phone_number iddiasi belge
    // kimligiyle BIREBIR eslesirse yazilabilir. Yani bir kullanici yalnizca
    // Firebase Auth'ta GERCEKTEN dogruladigi numarayi kaydedebilir; baskasinin
    // numarasini rezerve edip o kisinin kaydolmasini engelleyemez.
    //
    // Var olan bir kaydin UZERINE YAZILABILIR: Firebase Auth bir numarayi ayni
    // anda tek hesaba baglar, dolayisiyla token'inda o numara olan kullanici
    // numaranin GUNCEL sahibidir. Eski sahibin kaydi (ör. birakma yazmasi
    // basarisiz oldugu icin) duruyorsa bu, yeni sahibi kilitlememelidir.
    match /phone_owners/{phoneNumber} {
      // "verified": numara Firebase Auth'ta GERCEKTEN bu hesaba bagli.
      // Kanit, ID token'indaki phone_number iddiasidir — sahtelenemez, bu yuzden
      // her kaydin (baskasinin eski kaydi dahil) uzerine yazabilir. Firebase Auth
      // bir numarayi ayni anda tek hesaba bagladigi icin bu dogrudur.
      function isVerifiedClaim() {
        return request.resource.data.status == "verified"
          && request.auth.token.phone_number is string
          && request.auth.token.phone_number == phoneNumber;
      }

      // "pending": numaraya SMS gonderildi, kod henuz onaylanmadi. Kanit
      // TASIMAZ — bu yuzden yalnizca 15 dakika gecerlidir ve suresi dolunca
      // baskasi ayni numarayi rezerve edebilir. Boylece kimse bir numarayi
      // suresiz kilitleyip baskasinin kaydolmasini engelleyemez.
      function pendingExpired() {
        return resource.data.status == "pending"
          && resource.data.updatedAt is timestamp
          && request.time > resource.data.updatedAt + duration.value(15, 'm');
      }

      function canReserve() {
        return request.resource.data.status == "pending"
          && (
            resource == null
            || resource.data.uid == request.auth.uid
            || pendingExpired()
          );
      }

      allow get: if isSignedIn();
      allow list: if false;

      // updatedAt'in serverTimestamp olmasi SART: aksi halde istemci ileri
      // tarihli bir damga yazip rezervasyonunu sonsuza kadar taze gosterebilirdi.
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(["uid", "status", "updatedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (isVerifiedClaim() || canReserve());

      // Numara degistirilince ya da dogrulamadan vazgecilince kayit birakilir —
      // yalnizca sahibi silebilir.
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /events/{eventId} {
      // Giris yapmis kullanici: eskisi gibi tum etkinlikleri okuyabilir.
      // Misafir (mobil "Kesfet" ekrani): yalnizca gizlenmemis etkinlikler.
      //
      // ONEMLI: Firestore'da sorgu izni donen belgelere degil SORGUNUN
      // kendisine bakar. Kuralin resource.data'ya bagli tarafi, ancak sorgu
      // ayni alani filtreliyorsa gecer. Bu yuzden misafir tarafi
      //     where('hiddenGlobally', isEqualTo: false)
      // ile sorgulamak ZORUNDA. isSignedIn() dali ise belgeden bagimsiz
      // oldugu icin girisli kullanicinin filtresiz sorgusu calismaya devam
      // eder (ogrenci paneli boyle sorguluyor).
      //
      // NOT: Bu kural etkinlik dokumanini misafire tumuyle acar; icinde
      // locationLat/locationLng (etkinligin tam GPS konumu), quota ve
      // feeAmount da var. Katilimci listesi (event_registrations) ve
      // profiller etkilenmez, onlarin kurallari ayri.
      allow read: if isSignedIn() || resource.data.hiddenGlobally == false;

      // Etkinlik yayinlamak icin ONAYLI kulup olmak sart: belge incelemesini
      // bekleyen ya da beyanla kulup gorunen bir hesap etkinlik olusturamaz.
      //
      // UCRETLI etkinlik ayrica onay logu olmadan OLUSTURULAMAZ.
      allow create: if isApprovedClub()
        && request.resource.data.clubId == request.auth.uid
        && (
          !isPaidEventData(request.resource.data)
          || paidConsentLogValid(request.resource.data)
        );

      // Guncellemede iki sart:
      //   • Ucretsizden UCRETLIYE gecen etkinlik onay logu tasimali.
      //     (Zaten ucretli olan ESKI etkinlikler bu kural yayinlanmadan once
      //     olusmus olabilir; onlari kilitlemiyoruz, yoksa kulup kendi
      //     etkinliginin kaydini bile kapatamaz hale gelirdi.)
      //   • Var olan gecerli bir log SILINEMEZ/BOZULAMAZ.
      allow update: if isSignedIn()
        && resource.data.clubId == request.auth.uid
        // Kayitlari yeniden acmak icin kapi kapali ve oturumlar basta olmali.
        // Ilgisiz eski belge guncellemelerini kilitlemeden durum yazimini koru.
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['registrationClosed', 'entryOpen', 'currentSession'])
          || request.resource.data.get('registrationClosed', false) == true
          || (
            request.resource.data.get('entryOpen', false) == false
            && request.resource.data.get('currentSession', 0) == 0
          )
        )
        && (
          !isPaidEventData(request.resource.data)
          || isPaidEventData(resource.data)
          || paidConsentLogValid(request.resource.data)
        )
        && (
          !paidConsentLogValid(resource.data)
          // Etkinlik UCRETSIZE cevriliyorsa log anlamini yitirir ve silinebilir
          // (web: club-create-event.js -> paidConsentLog: deleteField()).
          || !isPaidEventData(request.resource.data)
          || paidConsentLogValid(request.resource.data)
        );

      allow delete: if isSignedIn() && resource.data.clubId == request.auth.uid;
    }

    // ── Kontenjan parcalari (sharded counter) ─────────────────────────────
    // events/{eventId}/quota_shards/{0..S-1}  ->  { count, capacity }
    //
    // NEDEN VAR: kontenjani korumak, kaydi bir sayacla BIRLIKTE atomik
    // yazmayi gerektirir. Sayac tek dokumanda tutulursa o dokuman butun
    // etkinligin darbogazi olur (Firestore'da tek dokumana surdurulebilir
    // yazma: saniyede ~1). Yuk testinde tek sayacli kurulum 100 eszamanli
    // kayitta %99 hata verdi. Kapasiteler parcalara bolunur; toplamlari TAM
    // OLARAK kontenjandir, boylece ne asim ne eksik olur.
    // Bkz. lib/domain/registration_capacity.dart, tool/loadtest/
    match /events/{eventId}/quota_shards/{shardId} {
      function eventPath() {
        return /databases/$(database)/documents/events/$(eventId);
      }

      // Parcalar etkinlikle AYNI toplu yazimda kuruluyor (atomik olmasi
      // gerekir: parcasiz ama "parcali" gorunen bir etkinlik, kaydolmaya
      // calisan herkese "kontenjan doldu" derdi). O anda etkinlik dokumani
      // HENUZ YOKTUR, bu yuzden get() degil getAfter(): islem bittiginde
      // olusacak hale bakiyoruz. Etkinligin degismedigi normal durumlarda
      // getAfter zaten mevcut hali dondurur.
      function isEventOwnerAfter() {
        return isSignedIn()
          && existsAfter(eventPath())
          && getAfter(eventPath()).data.clubId == request.auth.uid;
      }

      function isEventOwner() {
        return isSignedIn()
          && exists(eventPath())
          && get(eventPath()).data.clubId == request.auth.uid;
      }

      // Ogrencinin BU etkinlikteki kaydinin yolu. Kimlik deterministik
      // oldugu icin (eventId + "_" + uid) kurallar da hesaplayabiliyor.
      function myRegistration() {
        return /databases/$(database)/documents/event_registrations/$(eventId + "_" + request.auth.uid);
      }

      allow read: if isSignedIn();

      // Parcalari YALNIZCA etkinligin sahibi kulup kurar ve siler. Istemciye
      // parca yaratma izni verilseydi kapasiteyi kendisi belirler, kontenjan
      // diye bir sey kalmazdi.
      allow create: if isEventOwnerAfter();
      allow delete: if isEventOwner();

      allow update: if isEventOwner()
        || (
          isSignedIn()
          && request.resource.data.keys().hasOnly(["count", "capacity"])
          // Kapasite ASLA istemciden degismez.
          && request.resource.data.capacity == resource.data.capacity
          && (
            // YER KAPMA: sayac tam +1 ve kapasiteyi asmiyor. Sart, islem
            // BITTIGINDE ogrencinin kaydinin gercekten var olmasi ve bu
            // parcayi gostermesi — yani kayit yazmadan sayac artirilamaz.
            (
              request.resource.data.count == resource.data.count + 1
              && request.resource.data.count <= resource.data.capacity
              && existsAfter(myRegistration())
              && getAfter(myRegistration()).data.quotaShard == int(shardId)
            )
            ||
            // YER BIRAKMA: sayac tam -1. Sart, islem BITTIGINDE kaydin
            // silinmis olmasi — kimse kaydini silmeden yer acamaz, yani
            // sayaci dusurup kontenjani sisirmek mumkun degil.
            (
              request.resource.data.count == resource.data.count - 1
              && request.resource.data.count >= 0
              && !existsAfter(myRegistration())
            )
          )
        );
    }

    match /event_registrations/{registrationId} {
      function clubCanReadRegistration() {
        return isClubUser()
          && eventDoc(resource.data.eventId).data != null
          && eventDoc(resource.data.eventId).data.clubId == request.auth.uid;
      }

      function clubCanMarkCheckIn() {
        return isClubUser()
          && eventDoc(resource.data.eventId).data != null
          && eventDoc(resource.data.eventId).data.clubId == request.auth.uid
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "checkedInAt",
            "checkedInAtMs",
            "checkedInByClubId",
            "updatedAt",
            "sessionsAttended",
            "lastSessionCheckInAtMs",
            "lastAttendedSession"
          ])
          && request.resource.data.checkedInByClubId == request.auth.uid
          && request.resource.data.checkedInAtMs is int
          && request.resource.data.checkedInAtMs > 0;
      }

      // Kulup "Oturumu Geri Al" ile etkinligin oturum imlecini bir adim geri
      // aldiginda, o oturumda giris yapmis ogrencilerin girisi de geri alinir
      // — aksi halde ogrenci girisin onaylandigini gorurken kulup panelinde
      // o oturum artik yasanmamis olur. Yalnizca GERI ALINAN oturuma ait
      // kayitlar dokunulabilir (lastAttendedSession, etkinligin O ANKI —
      // henuz geri alinmamis — currentSession'ina esit olmali) ve deger tam
      // olarak bir adim geri gitmeli; toplu/keyfi degisiklik engellenir.
      function clubCanRevertSessionCheckIn() {
        return isClubUser()
          && eventDoc(resource.data.eventId).data != null
          && eventDoc(resource.data.eventId).data.clubId == request.auth.uid
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "sessionsAttended",
            "lastAttendedSession",
            "updatedAt"
          ])
          && resource.data.lastAttendedSession is int
          && resource.data.lastAttendedSession == eventDoc(resource.data.eventId).data.currentSession
          && request.resource.data.lastAttendedSession == eventDoc(resource.data.eventId).data.currentSession - 1
          && request.resource.data.sessionsAttended
              == (resource.data.sessionsAttended is int ? resource.data.sessionsAttended : 0) - 1;
      }

      // Ogrenci, kulubun ekrana bastigi oturum QR'ini kendi kamerasindan
      // okuttugunda SADECE KENDI kaydindaki oturum alanlarini gunceller.
      // Kopyalama/hile onlemleri:
      //  - lastAttendedSession, etkinligin O ANKI currentSession'ina esit olmali
      //    (eski/gelecek bir QR kabul edilmez).
      //  - lastAttendedSession bir onceki degerinden KESINLIKLE buyuk olmali
      //    (ayni oturumu ikinci kez bildirip sayim artiramaz).
      //  - sessionsAttended tam olarak +1 artmali (toplu/sahte artis engellenir).
      //  - checkedInByClubId bu yoldan YAZILAMAZ (kulup dogrulamasi degil,
      //    ogrenci kendi kendine giris yaptigi ayirt edilsin).
      function studentCanMarkOwnSessionCheckIn() {
        return isSignedIn()
          && resource.data.studentId == request.auth.uid
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "checkedInAt",
            "checkedInAtMs",
            "sessionsAttended",
            "lastSessionCheckInAtMs",
            "lastAttendedSession",
            "updatedAt"
          ])
          && eventDoc(resource.data.eventId).data != null
          && eventDoc(resource.data.eventId).data.get("sessionsCompleted", false) != true
          // KAPI SARTI: "Check-in + Yoklama" modunda (checkinMode ==
          // "checkin_attendance") oturum yoklamasi ancak ogrenci sabah
          // kapida check-in yaptiysa gecerlidir. Kulup gec kalanlari da
          // almak isterse etkinlik panelinden allowSessionWithoutCheckin
          // anahtarini acar ve sart kalkar.
          //
          // .get(alan, varsayilan) kullaniliyor: bu iki alan eklenmeden
          // once olusturulmus etkinliklerde YOKTUR. Varsayilanlarla eski
          // kayitlar "checkin_attendance degil" sayilir ve kosul, bugunku
          // davranisi aynen koruyarak dogrudan gecer.
          && (
            eventDoc(resource.data.eventId).data.get("checkinMode", "") != "checkin_attendance"
            || eventDoc(resource.data.eventId).data.get("allowSessionWithoutCheckin", false) == true
            || (resource.data.get("checkedInAtMs", 0) is int
              && resource.data.get("checkedInAtMs", 0) > 0)
          )
          // DIKKAT: asagidaki sayaclar KAYIT ANINDA YAZILMIYOR — ne web
          // (dashboard.js) ne mobil (EventRepository.registerToEvent) bu iki
          // alani olusturuyor. Alan yokken `resource.data.sessionsAttended`
          // yazmak kural degerlendirmesini HATAYA dusurur ("Property ... is
          // undefined on object") ve `is int ? : 0` uclusu bunu kurtarmaz:
          // tip kontrolunden ONCE alana erisilir. Sonuc, ogrencinin ILK
          // oturum yoklamasinin her zaman permission-denied almasiydi.
          // Bu yuzden hepsi .get(alan, varsayilan) ile okunur.
          && request.resource.data.lastAttendedSession
              == eventDoc(resource.data.eventId).data.get("currentSession", 0)
          && request.resource.data.lastAttendedSession
              > (resource.data.get("lastAttendedSession", 0) is int
                ? resource.data.get("lastAttendedSession", 0) : 0)
          && request.resource.data.sessionsAttended
              == (resource.data.get("sessionsAttended", 0) is int
                ? resource.data.get("sessionsAttended", 0) : 0) + 1
          && request.resource.data.checkedInAtMs is int
          && request.resource.data.checkedInAtMs > 0;
      }

      // Tek oturumlu etkinlik: ogrenci, kulubun KAPIDA gosterdigi giris QR'ini
      // telefon kamerasindan okuttugunda kendi kaydini "giris yapildi" olarak
      // isaretler. QR'in kendisi bir sir DEGILDIR (ekran goruntusu paylasilabilir);
      // asil sinirlar burada:
      //  - events.entryOpen true olmali: kapiyi kulup acar ve kapatir, kapali
      //    kapida hicbir QR ise yaramaz.
      //  - Kayit ZATEN giris yapmis olmamali (checkedInAtMs bir kez yazilir);
      //    ayni kayit ikinci kez giris bildiremez.
      //  - checkedInByClubId bu yoldan YAZILAMAZ; girisin kulup dogrulamasiyla
      //    mi yoksa ogrencinin kendisi tarafindan mi yapildigi ayirt edilsin
      //    diye kaynak checkedInVia == "self-qr" olarak isaretlenir.
      //  - Oturum alanlarina dokunulamaz; oturumlu etkinligin yolu ayridir
      //    (bkz. studentCanMarkOwnSessionCheckIn).
      function studentCanMarkOwnEventCheckIn() {
        return isSignedIn()
          && resource != null
          && resource.data.studentId == request.auth.uid
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "checkedInAt",
            "checkedInAtMs",
            "checkedInVia",
            "updatedAt"
          ])
          && eventDoc(resource.data.eventId).data != null
          // .get(...): "entryOpen" alani bu ozellik eklenmeden once
          // olusturulmus etkinliklerde YOKTUR; varsayilan false ile kapi
          // kapali sayilir. `checkedInAtMs` de HENUZ GIRIS YAPMAMIS kayitta
          // bulunmaz — dogrudan erisim kural degerlendirmesini hataya
          // dusurup ogrencinin ilk kapi okutmasini reddediyordu.
          && eventDoc(resource.data.eventId).data.get("entryOpen", false) == true
          && !(resource.data.get("checkedInAtMs", 0) is int
            && resource.data.get("checkedInAtMs", 0) > 0)
          && request.resource.data.checkedInVia == "self-qr"
          && request.resource.data.checkedInAtMs is int
          && request.resource.data.checkedInAtMs > 0;
      }

      // Ogrenci profilini guncelledikten sonra KENDI kayitlarindaki kisisel
      // bilgi kopyasini tazeler. Kulup student_profiles'i okuyamadigi icin
      // Excel ciktisi ve sertifikaya islenen ad bu kopyadan gelir; kopya
      // tazelenmezse belge her zaman ESKI adla uretilir.
      //
      // Bu dal bilerek hedef-kitle (scope) kontrolu YAPMAZ: ogrenci bolumunu
      // degistirdiginde artik kapsam disinda kalabilir, ama zaten kayitli
      // oldugu etkinligin katilimci listesindeki adi yine de dogru olmalidir.
      // Yalnizca asagidaki kisisel alanlar degisebilir; eventId, studentId,
      // yoklama ve oturum alanlari bu yoldan DOKUNULAMAZ.
      function studentCanRefreshOwnSnapshot() {
        return isSignedIn()
          && resource != null
          && resource.data.studentId == request.auth.uid
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "studentName",
            "studentFirstName",
            "studentLastName",
            "studentEmail",
            "studentPhone",
            "studentPhotoUrl",
            "studentUniversity",
            "studentDepartment",
            "studentClassYear",
            "studentNumber",
            "studentCity",
            "studentDistrict",
            "profileSyncedAtMs",
            "updatedAt"
          ]);
      }

      function registrationPayloadValid() {
        return request.resource.data.studentId == request.auth.uid
          && request.resource.data.eventId is string
          && registrationId == request.resource.data.eventId + "_" + request.auth.uid;
      }

      function targetEventAllowsRegistration() {
        return eventDoc(request.resource.data.eventId).data != null
          && eventDoc(request.resource.data.eventId).data.hiddenGlobally != true
          && eventDoc(request.resource.data.eventId).data.registrationClosed != true
          && eventDoc(request.resource.data.eventId).data.get('entryOpen', false) == false
          && eventDoc(request.resource.data.eventId).data.get('currentSession', 0) == 0;
      }

      // ── Kontenjan (parca sayaci) ─────────────────────────────────────────
      // Kontenjan yalnizca istemcide kontrol edilseydi hicbir sey ifade
      // etmezdi: ogrenci konsoldan dogrudan setDoc cagirip kontenjani
      // asabilirdi. Asil sinir burasi.
      //
      // Kural: etkinlik parcalara ayrilmissa (quotaShardCount > 0), kayit
      // belgesi ancak AYNI ISLEMDE isaret ettigi parcanin sayaci 1 arttiysa
      // olusabilir. getAfter(), islem TAMAMLANDIKTAN sonraki hali dondurur;
      // yani "once sayaci artir, sonra kaydi yaz" hilesi yapilamaz — ikisi
      // tek bir atomik islem olmak zorundadir.
      //
      // Parca sistemi gelmeden once olusturulmus etkinliklerde
      // quotaShardCount alani yoktur; onlar eski davranisla calismaya devam
      // eder (eventUsesQuotaShards() false doner).
      function eventUsesQuotaShards() {
        return eventDoc(request.resource.data.eventId).data.quotaShardCount is int
          && eventDoc(request.resource.data.eventId).data.quotaShardCount > 0;
      }

      function claimedShardPath() {
        return /databases/$(database)/documents/events/$(request.resource.data.eventId)/quota_shards/$(string(request.resource.data.quotaShard));
      }

      function slotClaimedInSameCommit() {
        return request.resource.data.quotaShard is int
          && request.resource.data.quotaShard >= 0
          && request.resource.data.quotaShard < eventDoc(request.resource.data.eventId).data.quotaShardCount
          && exists(claimedShardPath())
          && existsAfter(claimedShardPath())
          && getAfter(claimedShardPath()).data.count == get(claimedShardPath()).data.count + 1;
      }

      // Kaydin yazildigi etkinlik ucretli mi? Ucretliyse kayit belgesi
      // ogrencinin onay logunu TASIMAK ZORUNDA.
      function targetEventIsPaid() {
        return eventDoc(request.resource.data.eventId).data.get("feeType", "") == "paid";
      }

      function paidRegistrationConsentGiven() {
        return !targetEventIsPaid()
          || paidConsentLogValid(request.resource.data);
      }

      // GUNCELLEMEDE kullanilir. Etkinligi bir kez daha okumak (yukaridaki
      // targetEventIsPaid) kural degerlendirmesinin 1000 ifade butcesini
      // asiyor ve MESRU guncellemeler bile "evaluation error" ile
      // reddediliyordu. Guncellemede zaten kaydin kendisi elimizde: var olan
      // gecerli bir onay logu SILINEMEZ/BOZULAMAZ demek yeterli, cunku log
      // olusturma aninda zorunlu tutuluyor.
      function consentLogNotWeakened() {
        return !paidConsentLogValid(resource.data)
          || paidConsentLogValid(request.resource.data);
      }

      function quotaRespected() {
        return !eventUsesQuotaShards() || slotClaimedInSameCommit();
      }

      // Kayit belgesi bir kez yazildiktan sonra hangi parcaya ait oldugu
      // DEGISTIRILEMEZ. Aksi halde ogrenci kaydini bos bir parcaya tasiyip
      // dolu parcanin sayacini kalici olarak sisirebilirdi.
      function shardBindingUnchanged() {
        return !eventUsesQuotaShards()
          || (
            resource.data.quotaShard is int
            && request.resource.data.quotaShard == resource.data.quotaShard
          );
      }

      // ── Hedef kitle (kapsam) kontrolu ────────────────────────────────────
      // Etkinlik "sadece universiteye" ya da "sadece bolume/bolum+universiteye"
      // ozelse, sartlari karsilamayan ogrenci KAYIT OLAMAZ. Istemci ayni
      // kontrolu yapar (canStudentSeeEvent) ama asil sinir burasidir;
      // registrationDebugMode bu kontrolu BYPASS ETMEZ.
      function studentProfileData() {
        return get(/databases/$(database)/documents/student_profiles/$(request.auth.uid)).data;
      }

      function eventTargetDepartments(eventData) {
        return ("targetDepartments" in eventData && eventData.targetDepartments is list)
          ? eventData.targetDepartments
          : (
            ("targetDepartment" in eventData
              && eventData.targetDepartment is string
              && eventData.targetDepartment != "")
              ? [eventData.targetDepartment]
              : []
          );
      }

      function studentMatchesDepartment(eventData) {
        return eventTargetDepartments(eventData).hasAny([studentProfileData().department]);
      }

      function studentMatchesUniversity(eventData) {
        return "targetUniversity" in eventData
          && eventData.targetUniversity is string
          && eventData.targetUniversity != ""
          && eventData.targetUniversity == studentProfileData().university;
      }

      // Eski kayitlarda "department" kapsami bolum + universite demekti
      // (targetDepartments dizisi yoktu, targetUniversity doluydu).
      function isLegacyDepartmentUniversityScope(eventData) {
        return !("targetDepartments" in eventData)
          && "targetUniversity" in eventData
          && eventData.targetUniversity is string
          && eventData.targetUniversity != "";
      }

      function studentMeetsEventScope(eventData) {
        return !("targetScope" in eventData)
          || eventData.targetScope == "public"
          || (
            eventData.targetScope == "university"
            && studentMatchesUniversity(eventData)
          )
          || (
            eventData.targetScope == "department_university"
            && studentMatchesUniversity(eventData)
            && studentMatchesDepartment(eventData)
          )
          || (
            eventData.targetScope == "department"
            && studentMatchesDepartment(eventData)
            && (
              !isLegacyDepartmentUniversityScope(eventData)
              || studentMatchesUniversity(eventData)
            )
          );
      }

      function studentEligibleForTargetEvent() {
        return eventDoc(request.resource.data.eventId).data != null
          && studentMeetsEventScope(eventDoc(request.resource.data.eventId).data);
      }

      // Kendi kaydini okumak, belge HENUZ YOKKEN de mumkun olmali.
      //
      // Kontenjan islemi (bkz. quota-shards.js claimSpecificShard) cift kayit
      // olusmasin diye ONCE ogrencinin kendi kayit belgesini okur. Belge
      // yoksa `resource` null olur; alttaki `resource.data.studentId`
      // kontrolu bu durumda hata verip erisimi reddediyordu — yani kayit
      // olmayan HERKES icin islem daha ilk okumada patliyordu.
      //
      // Kimlik deterministik oldugu icin (eventId + "_" + uid) belgenin
      // istegi yapan kisiye ait olup olmadigi, belge olmasa bile kimlikten
      // anlasilir. Baskasinin kaydina bu daldan erisilemez.
      function readingOwnMissingRegistration() {
        return resource == null
          && registrationId.matches('^.*_' + request.auth.uid + '$');
      }

      allow read: if isSignedIn()
        && (
          readingOwnMissingRegistration()
          || (resource != null && resource.data.studentId == request.auth.uid)
          || clubCanReadRegistration()
        );

      allow create: if isSignedIn()
        && registrationPayloadValid()
        && studentEligibleForTargetEvent()
        && quotaRespected()
        && paidRegistrationConsentGiven()
        && (
          registrationDebugMode()
          || targetEventAllowsRegistration()
        );

      allow update: if (
          isSignedIn()
          && registrationPayloadValid()
          && studentEligibleForTargetEvent()
          && shardBindingUnchanged()
          && consentLogNotWeakened()
          && (
            registrationDebugMode()
            || targetEventAllowsRegistration()
          )
        )
        || clubCanMarkCheckIn()
        || clubCanRevertSessionCheckIn()
        || studentCanMarkOwnSessionCheckIn()
        || studentCanMarkOwnEventCheckIn()
        || studentCanRefreshOwnSnapshot();

      allow delete: if isSignedIn()
        && (
          resource.data.studentId == request.auth.uid
          || clubCanReadRegistration()
        );
    }

    // Ogrenci belgeleri/sertifikalari: kulup olusturur (dagitir),
    // ogrenci kendi belgesini goruntuler ve silebilir.
    match /student_certificates/{certificateId} {
      allow read: if isSignedIn()
        && (resource.data.studentId == request.auth.uid || resource.data.clubId == request.auth.uid);

      allow create, update: if isSignedIn()
        && request.resource.data.clubId == request.auth.uid;

      allow delete: if isSignedIn()
        && (resource.data.studentId == request.auth.uid || resource.data.clubId == request.auth.uid);
    }

    // ── Yonetici bildirimleri ─────────────────────────────────────────────
    // Yonetici bir universiteyi hedefleyerek tek bir bildirim belgesi yazar;
    // alici basina kopya URETILMEZ (Cloud Functions yok). Kullanicilar kendi
    // universitelerini ve rollerini filtreleyerek okur:
    //   where('university','==',...) + where('audience','in',[rol,'both'])
    //
    // Okuma giris yapmis herkese acik: bildirim metni duyuru niteliginde,
    // kisisel veri tasimaz. Yazma YALNIZCA admin.
    match /notifications/{notificationId} {
      // Bildirimler yalnizca yonetici panelinden gonderilir; kullanici
      // arayuzunde okunmadigi icin okuma da yoneticiye kapali tutulur.
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.university is string
        && request.resource.data.university.size() > 0
        && request.resource.data.audience in ["student", "club", "both"]
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000;

      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
