# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Node.js dependencies and local load-test output
**/node_modules/
/tool/loadtest/logs/

# Local environment and credential files
.env
.env.*
!.env.example
**/.firebase/
*.pem
*.p12
*.pfx
*.key

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle derleme ciktisi. Kokteki `/build/` yalnizca kok dizini kapsiyor;
# android/build asagidaki satir olmadan depoya girer.
/android/build/
/android/.gradle/

# CocoaPods. Mac'te `pod install` bu dizini ve kilit dosyasini uretir;
# ikisi de makineye ozel yollar tasidigi icin depoya girmemeli.
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/ephemeral/

# Apple imzalama materyali. *.p12/*.pem/*.key yukarida kapsandi; APNs
# kimlik dogrulama anahtari (.p8) ve provisioning profilleri de girmemeli.
*.p8
*.mobileprovision
*.certSigningRequest

# Yedek dosyalar (ornek: google-services.json.bak).
*.bak

# Test kullanicilarinin e-posta listesi: kisisel veri, kaynak kod degil.
testers.csv
